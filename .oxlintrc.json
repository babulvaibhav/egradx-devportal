{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "import",
    "nextjs"
  ],
  "categories": {},
  "env": {
    "builtin": true
  },
  "settings": {
    "react": {
      "version": "19.3.0"
    },
    "tailwindcss": {
      "callees": [
        "clsx",
        "cva",
        "cn"
      ]
    }
  },
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "out/",
    ".next/",
    "public/reference/",
    "sources/",
    "examples/",
    "initializr/templates/",
    "tools/reference/.out/"
  ]
}
