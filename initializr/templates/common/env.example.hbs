# Copy to .env (never commit it) or set these in your environment.
{{#if (eq language "java")}}
DB_URL=jdbc:postgresql://localhost:5432/{{project.module}}
{{else}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/{{project.module}}
{{/if}}
# Protects the signing keys the SDK creates in ./keys on the first start. Keep it secret; changing it locks the keys.
EGRADX_KEY_PASSPHRASE=change-me
# The demo organization's administrator, ada@example.com, signs in with this.
DEMO_PASSWORD=demo-password
{{#if cap.email}}
SMTP_HOST=localhost
SMTP_PORT=1025
{{/if}}
{{#if cap.events}}
{{#if (eq option.events.transport "rabbitmq")}}
{{#if (eq language "java")}}
RABBITMQ_HOST=localhost
{{else}}
EGRADX_EVENTS_RABBITMQ_URL=amqp://guest:guest@localhost:5672
{{/if}}
{{/if}}
{{#if (eq option.events.transport "kafka")}}
{{#if (eq language "java")}}
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
{{else}}
EGRADX_EVENTS_KAFKA_BROKERS=localhost:9092
{{/if}}
{{/if}}
{{/if}}
