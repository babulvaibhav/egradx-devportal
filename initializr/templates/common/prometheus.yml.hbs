# Prometheus scrapes the application running on your machine (not in Docker).
scrape_configs:
  - job_name: {{project.artifact}}
    scrape_interval: 15s
{{#if (eq language "java")}}
    metrics_path: /actuator/prometheus
{{else}}
    metrics_path: /metrics
{{/if}}
    static_configs:
      - targets: ["host.docker.internal:8080"]
