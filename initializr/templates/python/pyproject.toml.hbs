# docs:region pyproject
[project]
name = "{{project.artifact}}"
version = "0.0.1"
description = "{{project.description}}"
requires-python = ">=3.12"
dependencies = [
    "egradx-sdk=={{sdkVersion}}",
{{#if cap.events}}
{{#if (eq option.events.transport "in-process")}}
    "egradx-events=={{sdkVersion}}",
{{else}}
    "egradx-events[{{option.events.transport}}]=={{sdkVersion}}",
{{/if}}
{{/if}}
{{#if cap.tracing}}
    "opentelemetry-sdk>=1.27",
    "opentelemetry-exporter-otlp-proto-http>=1.27",
    "opentelemetry-exporter-prometheus>=0.48b0",
    "opentelemetry-instrumentation-asgi>=0.48b0",
{{/if}}
    "fastapi",
    "uvicorn",
]
{{#if extra.tests}}

[dependency-groups]
dev = ["pytest>=8.3", "pytest-asyncio>=1.0", "httpx>=0.28"{{#if cap.email}}, "aiosmtpd>=1.4"{{/if}}]
{{/if}}

[tool.uv]
package = false
find-links = ["egradx-wheels"]   # the SDK's wheels, downloaded by scripts/get_wheels.py
# docs:end
{{#if extra.tests}}

[tool.pytest.ini_options]
asyncio_mode = "auto"
testpaths = ["tests"]
{{/if}}
