"""Runs {{project.name}}: `uv run python main.py`."""

import asyncio
import logging
import os
import selectors
import sys

import uvicorn
from egradx.sdk import CORRELATION_FORMAT, install_log_correlation

{{#if cap.tracing}}
from telemetry import instrument, start_telemetry

start_telemetry("{{project.artifact}}")  # before the application is built, so everything it creates is instrumented
{{/if}}
from application import AppConfig, Application  # noqa: E402


def required(name: str) -> str:
    value = os.environ.get(name)
    if not value:
        sys.exit(f"Set {name} (see .env.example)")
    return value


# docs:region log-correlation
# Every log line carries its trace and request ids.
logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s " + CORRELATION_FORMAT + "%(name)s - %(message)s")
install_log_correlation()
# docs:end

application = Application(AppConfig(
    database_url=required("DATABASE_URL"),  # postgresql://postgres:postgres@localhost:5432/{{project.module}}
    keystore_path=os.environ.get("EGRADX_KEYSTORE_PATH", "keys"),
    key_passphrase=required("EGRADX_KEY_PASSPHRASE"),  # protects the signing keys; keep it secret
    demo_password=os.environ.get("DEMO_PASSWORD", "demo-password"),
{{#if cap.email}}
    smtp_host=os.environ.get("SMTP_HOST", "localhost"),
    smtp_port=int(os.environ.get("SMTP_PORT", "1025")),
{{/if}}
))
app = {{#if cap.tracing}}instrument(application.app){{else}}application.app{{/if}}


# docs:region run
def selector_loop() -> asyncio.AbstractEventLoop:
    """psycopg's async mode needs a selector event loop, which Windows doesn't use by default."""
    return asyncio.SelectorEventLoop(selectors.SelectSelector()) if sys.platform == "win32" else asyncio.new_event_loop()


if __name__ == "__main__":
    server = uvicorn.Server(uvicorn.Config(app, host=os.environ.get("HOST", "127.0.0.1"), port=int(os.environ.get("PORT", "8080")), loop="none"))
    asyncio.run(server.serve(), loop_factory=selector_loop)
# docs:end
