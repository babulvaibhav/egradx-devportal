# Build: python scripts/get_wheels.py && docker build -t {{project.artifact}} .
FROM python:3.13-slim
COPY --from=ghcr.io/astral-sh/uv:0.12.21 /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml ./
COPY egradx-wheels egradx-wheels
RUN uv sync --no-dev
COPY . .
# The signing keys live here: mount one volume shared by every instance, and start one instance first.
VOLUME /app/keys
ENV EGRADX_KEYSTORE_PATH=/app/keys
# Listen on every interface: 127.0.0.1, the default outside a container, is unreachable from outside it.
ENV HOST=0.0.0.0
EXPOSE 8080
CMD ["uv", "run", "--no-dev", "python", "main.py"]
