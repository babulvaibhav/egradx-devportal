<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>{{project.group}}</groupId>
    <artifactId>{{project.artifact}}</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>{{project.name}}</name>
    <description>{{project.description}}</description>

    <!-- docs:region pom -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.9</version>
        <relativePath/>
    </parent>

    <properties>
        <java.version>21</java.version>
    </properties>

    <!-- The SDK's packages are on GitHub Packages: ~/.m2/settings.xml needs a server with this id and a token
         that can read packages (README.md). -->
    <repositories>
        <repository>
            <id>egradx-sdk-github</id>
            <url>https://maven.pkg.github.com/babulvaibhav/egradx-v1-workspace</url>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.egradx</groupId>
                <artifactId>egradx-bom</artifactId>
                <version>{{sdkVersion}}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Sign-in and identity, the audit trail, notifications, observability; with Flyway, the PostgreSQL driver and mail. -->
        <dependency>
            <groupId>com.egradx</groupId>
            <artifactId>egradx-sdk</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Your own tables, with Spring Data JPA. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
{{#if cap.events}}
        <!-- Events between services: CloudEvents through a transactional outbox. -->
        <dependency>
            <groupId>com.egradx</groupId>
            <artifactId>egradx-platform-events</artifactId>
        </dependency>
{{#if (eq option.events.transport "rabbitmq")}}
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
{{/if}}
{{#if (eq option.events.transport "kafka")}}
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
{{/if}}
{{/if}}
{{#if cap.tracing}}
        <!-- Metrics and traces: Actuator, Prometheus, and OpenTelemetry traces sent over OTLP. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>
{{/if}}
{{#if extra.tests}}

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
{{#if cap.email}}
        <!-- An SMTP server inside the tests, to read what the application sends. -->
        <dependency>
            <groupId>com.icegreen</groupId>
            <artifactId>greenmail-junit5</artifactId>
            <version>2.1.3</version>
            <scope>test</scope>
        </dependency>
{{/if}}
{{/if}}
    </dependencies>
    <!-- docs:end -->

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
