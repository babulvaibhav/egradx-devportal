name: ci
on: [push, pull_request]

jobs:
  build:
    runs-on: ubuntu-latest
    services:
      postgres:
        image: postgres:16-alpine
        env:
          POSTGRES_PASSWORD: postgres
          POSTGRES_DB: {{project.module}}_test
        ports: ["5432:5432"]
        options: --health-cmd "pg_isready -U postgres" --health-interval 5s --health-retries 10
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 21
          cache: maven
          server-id: egradx-sdk-github
          server-username: GITHUB_ACTOR
          server-password: EGRADX_PACKAGES_TOKEN
      # A token that can read the SDK's packages (repository secret EGRADX_PACKAGES_TOKEN, scope read:packages).
      - run: ./mvnw -B verify
        env:
          EGRADX_PACKAGES_TOKEN: $\{{ secrets.EGRADX_PACKAGES_TOKEN }}
          TEST_DB_URL: jdbc:postgresql://localhost:5432/{{project.module}}_test
