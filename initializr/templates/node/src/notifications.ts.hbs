import { fileURLToPath } from 'node:url';
import { EgradxNotificationType } from '@babulvaibhav/egradx-sdk';
import { NOTE_CREATED } from './notes.js';

// docs:region notification-type
/**
 * The messages this application sends. A type names the variables its templates may use; the templates live in
 * notification-templates/<key>/, and the application does not start if one uses a variable the type does not declare.
 */
export const notificationTypes = [
  EgradxNotificationType.builder(NOTE_CREATED)
    .description('Sent to the author of a new note')
    .requires('title')
    .userCanOptOut() // people may turn it off on their settings screen
    .build(),
];

export const templateDirectory = fileURLToPath(new URL('../notification-templates/', import.meta.url));
// docs:end
