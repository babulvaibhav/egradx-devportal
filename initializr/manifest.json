{
  "sdkVersion": "1.0.0",
  "languages": [
    {
      "id": "java",
      "name": "Java",
      "detail": "Java 21 · Spring Boot 3.4 · Maven"
    },
    {
      "id": "node",
      "name": "Node",
      "detail": "Node 24 · Express 5 · TypeScript · Prisma"
    },
    {
      "id": "python",
      "name": "Python",
      "detail": "Python 3.13 · FastAPI · SQLAlchemy · uv"
    }
  ],
  "capabilities": [
    {
      "id": "identity",
      "name": "Sign-in & identity",
      "group": "SDK core",
      "always": true,
      "description": "Users, organizations, roles and permissions, invitations, password reset, profiles and sessions, with their endpoints and tables.",
      "keywords": [
        "login",
        "auth",
        "authentication",
        "authorization",
        "users",
        "roles",
        "permissions",
        "tenant",
        "organization",
        "jwt",
        "token"
      ],
      "docs": "/docs/guides/identity"
    },
    {
      "id": "audit",
      "name": "Audit trail",
      "group": "SDK core",
      "always": true,
      "description": "An append-only record of who changed what, written in the same transaction as the change, with filters and export.",
      "keywords": [
        "audit",
        "history",
        "log",
        "compliance",
        "trail",
        "changes"
      ],
      "docs": "/docs/guides/audit"
    },
    {
      "id": "inapp",
      "name": "In-app notifications",
      "group": "SDK core",
      "always": true,
      "description": "An inbox per person with a live stream for the bell, read state, and announcements to an organization.",
      "keywords": [
        "notification",
        "bell",
        "inbox",
        "sse",
        "realtime",
        "push"
      ],
      "docs": "/docs/guides/notifications"
    },
    {
      "id": "correlation",
      "name": "Request ids & log correlation",
      "group": "SDK core",
      "always": true,
      "description": "An X-Request-ID on every request, in every log line, error body and audit record.",
      "keywords": [
        "request id",
        "correlation",
        "logging",
        "trace id",
        "observability"
      ],
      "docs": "/docs/guides/observability"
    },
    {
      "id": "email",
      "name": "Email",
      "group": "Notifications",
      "description": "Templated email through the application's SMTP server (Mailpit locally), queued with the change and retried. The sample emails a note's author.",
      "keywords": [
        "email",
        "mail",
        "smtp",
        "mailpit",
        "message",
        "template",
        "send"
      ],
      "docs": "/docs/guides/notifications"
    },
    {
      "id": "events",
      "name": "Events between services",
      "group": "Integration",
      "description": "CloudEvents published in the same transaction as the change, through an outbox, handled once per handler. The sample publishes note.created and counts it in a handler.",
      "keywords": [
        "events",
        "messaging",
        "outbox",
        "rabbitmq",
        "kafka",
        "queue",
        "cloudevents",
        "pubsub",
        "async",
        "broker"
      ],
      "options": [
        {
          "id": "transport",
          "name": "Transport",
          "default": "in-process",
          "values": [
            {
              "id": "in-process",
              "name": "In-process",
              "description": "No broker: handlers in this application. Moving to a broker later is configuration only."
            },
            {
              "id": "rabbitmq",
              "name": "RabbitMQ",
              "description": "A queue per service, retries and a dead-letter queue."
            },
            {
              "id": "kafka",
              "name": "Kafka",
              "description": "A topic per event type, kept and replayable; a .DLT topic for failures."
            }
          ]
        }
      ],
      "docs": "/docs/guides/events"
    },
    {
      "id": "log-shipping",
      "name": "Log shipping",
      "group": "Observability",
      "description": "Every log line also leaves the service as an egradx.log.record.v1 event, with its request, person and organization.",
      "keywords": [
        "logs",
        "logging",
        "shipping",
        "elk",
        "centralized",
        "log aggregation"
      ],
      "requires": [
        {
          "id": "events",
          "reason": "log lines travel over the events transport."
        }
      ],
      "docs": "/docs/guides/observability"
    },
    {
      "id": "tracing",
      "name": "Traces & metrics",
      "group": "Observability",
      "description": "OpenTelemetry traces to Jaeger and Prometheus metrics for every SDK operation; Jaeger and Prometheus in the compose file.",
      "keywords": [
        "tracing",
        "opentelemetry",
        "otel",
        "jaeger",
        "metrics",
        "prometheus",
        "monitoring",
        "actuator"
      ],
      "docs": "/docs/guides/observability"
    }
  ],
  "frontends": [
    {
      "id": "none",
      "name": "None",
      "description": "An API only"
    },
    {
      "id": "vite",
      "name": "React + Vite",
      "description": "Tokens in the browser, @babulvaibhav/egradx-react"
    },
    {
      "id": "next",
      "name": "Next.js",
      "description": "Tokens in HttpOnly cookies, @babulvaibhav/egradx-next"
    }
  ],
  "extras": [
    {
      "id": "tests",
      "name": "Tests",
      "description": "An integration test over HTTP: sign in, create a note, check its audit record, notice, email and event.",
      "default": true
    },
    {
      "id": "compose",
      "name": "Docker Compose",
      "description": "PostgreSQL, and Mailpit, the broker, Jaeger and Prometheus when chosen.",
      "default": true
    },
    {
      "id": "dockerfile",
      "name": "Dockerfile",
      "description": "An image for the application.",
      "default": false
    },
    {
      "id": "ci",
      "name": "GitHub Actions",
      "description": "Build and test on every push, against PostgreSQL.",
      "default": false
    },
    {
      "id": "ai-pack",
      "name": "AI context pack",
      "description": "egradx-sdk-docs/ and AGENTS.md/CLAUDE.md, so coding assistants build on the SDK instead of re-writing it.",
      "default": true
    }
  ],
  "files": {
