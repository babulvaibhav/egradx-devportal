      {
        "from": "common/frontend-README.md.hbs",
        "to": "frontend/README.md",
        "when": [
          "frontend:any"
        ]
      },
      {
        "from": "common/env.example.hbs",
        "to": "backend/.env.example"
      },
      {
        "from": "common/docker-compose.yml.hbs",
        "to": "docker-compose.yml",
        "when": [
          "extra:compose"
        ]
      },
