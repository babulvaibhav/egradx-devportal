{
  "name": "egradx-devportal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts/sync-sources.mjs && node scripts/build-reference.mjs && next build && node scripts/flatten-segment-prefetch.mjs out && node scripts/check-links.mjs out",
    "dev": "next dev",
    "start": "serve out",
    "types:check": "next typegen && tsc --noEmit",
    "lint": "oxlint",
    "sync": "node scripts/sync-sources.mjs",
    "reference": "node scripts/build-reference.mjs"
  },
  "dependencies": {
    "cn": "^0.4.0",
    "fumadocs-core": "16.16.1",
    "fumadocs-mdx": "15.4.6",
    "fumadocs-openapi": "^12.3.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.16.1",
    "handlebars": "^4.7.9",
    "jszip": "^3.10.2",
    "lucide-react": "^1.50.0",
    "mermaid": "^11.17.2",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "github-slugger": "^2.0.0",
    "mailparser": "^3.9.36",
    "oxlint": "^1.86.0",
    "pg": "^8.23.1",
    "postcss": "^8.5.28",
    "serve": "^14.2.6",
    "smtp-server": "^3.19.17",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "description": "The EGRADX Developer Portal: guides, examples from OIM, references and the AI context pack, as a static site (apps/egradx-devportal).",
  "engines": {
    "node": ">=22"
  }
}
